{
  "kind": "collectionType",
  "collectionName": "academic_contents",
  "info": {
    "singularName": "academic-content",
    "pluralName": "academic-contents",
    "displayName": "Academic Content"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "description": {
      "type": "richtext",
      "required": true
    },
    "price": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "category": {
      "type": "enumeration",
      "enum": ["nursing-assignment", "case-study", "care-plan", "research-paper", "exam-prep", "clinical-notes", "nursing-essay"],
      "required": true
    },
    "nursingLevel": {
      "type": "enumeration",
      "enum": ["lpn", "rn", "bsn", "msn", "dnp", "phd-nursing"],
      "required": true
    },
    "subject": {
      "type": "string",
      "required": true
    },
    "pages": {
      "type": "integer",
      "min": 1
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "text"
    },
    "downloadFile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["files"]
    },
    "previewFile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["files"]
    }
  }
}
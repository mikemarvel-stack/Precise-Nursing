# Server
HOST=0.0.0.0
PORT=1337
APP_KEYS=your_app_keys_here
API_TOKEN_SALT=your_api_token_salt_here
ADMIN_JWT_SECRET=your_admin_jwt_secret_here
TRANSFER_TOKEN_SALT=your_transfer_token_salt_here
JWT_SECRET=your_jwt_secret_here

# Database
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=precisenursing
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_db_password
DATABASE_SSL=false

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal Payment
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENVIRONMENT=sandbox

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET=precisenursing-uploads
AWS_BACKUP_BUCKET=precisenursing-backups

# Email
EMAIL_DEFAULT_FROM=noreply@precisenursing.com
ADMIN_EMAIL=admin@precisenursing.com

# Frontend
FRONTEND_URL=http://localhost:3000

# Security
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Google Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# SEO
SITE_URL=https://precisenursing.com
SITE_NAME=PreciseNursing
# Database Configuration
POSTGRES_DB=precisenursing_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Redis Configuration
REDIS_PASSWORD=your_secure_redis_password_here

# Strapi Configuration
JWT_SECRET=your_jwt_secret_here
ADMIN_JWT_SECRET=your_admin_jwt_secret_here
APP_KEYS=your_app_keys_here
API_TOKEN_SALT=your_api_token_salt_here
TRANSFER_TOKEN_SALT=your_transfer_token_salt_here

# Payment Configuration
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENVIRONMENT=live

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET=precisenursing-uploads
AWS_BACKUP_BUCKET=precisenursing-backups

# Email Configuration
EMAIL_DEFAULT_FROM=noreply@precisenursing.com
EMAIL_DEFAULT_REPLY_TO=support@precisenursing.com

# Frontend Configuration
FRONTEND_URL=https://precisenursing.com
NEXT_PUBLIC_API_URL=https://precisenursing.com/api

# Backup Configuration
BACKUP_RETENTION_DAYS=30

# Domain Configuration
DOMAIN=precisenursing.com